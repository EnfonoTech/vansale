# Per-customer build env. Copy this file to customers/.env.<id>
# (e.g. customers/.env.demo) and fill in the values.

CUSTOMER_NAME=demo
CUSTOMER_APP_ID=com.enfono.vansale.demo
CUSTOMER_APP_TITLE="Van Sale Demo"
CUSTOMER_THEME_PRIMARY=#2563eb
CUSTOMER_THEME_BG=#f8fafc

# API base — APK only. Web build uses the Frappe host it is served from.
VITE_API_BASE=https://van-demo.enfonoerp.com

VITE_DEFAULT_LOCALE=en
