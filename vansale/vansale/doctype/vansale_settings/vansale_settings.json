   "fieldname": "enable_route",
   "fieldtype": "Check",
   "label": "Enable route planning",
   "default": "1",
   "description": "Master switch. Off hides Today's Route everywhere and the app shows Van Stock in that slot instead. Individual vans can override this."
  },
  {
   "fieldname": "column_break_modules",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "require_pin",
   "fieldtype": "Check",
   "label": "Require PIN unlock",
   "default": "1",
   "description": "Master switch. On, drivers set a 4-digit PIN and re-enter it after 2 hours idle. Off, the app goes straight to Home after login. Individual vans and users can override this."
  },
  {
   "fieldname": "section_break_invoicing",
