  },
  {
   "fieldname": "legacy_section",
   "fieldtype": "Section Break",
   "label": "Admin",
   "collapsible": 1
  },
  {
   "fieldname": "plan_date",
   "fieldtype": "Date",
   "label": "Effective From",
   "description": "Optional anchor date. The route only fires on or after this date; leave blank to start immediately."
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "stops",
   "fieldtype": "Table",
   "label": "Stops",
   "options": "Van Route Stop",
   "reqd": 1,
   "description": "Customers the driver visits on this route. The customer picker is filtered to customers whose Sales Team includes the Sales User above \u2014 assign customers to the user's sales person to make them appear here."
