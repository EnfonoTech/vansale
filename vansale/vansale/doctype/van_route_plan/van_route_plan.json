   "label": "Series",
   "options": "VRP-.#####",
   "default": "VRP-.#####",
   "reqd": 1,
   "hidden": 1
  },
  {
   "fieldname": "route_name",
   "fieldtype": "Data",
   "label": "Route Name",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Friendly name shown to the driver (e.g. 'North Jeddah Monday run')."
  },
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "Sales User",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1,
