   "label": "Status",
   "options": "Active\nCompleted",
   "default": "Active",
   "in_list_view": 1,
   "read_only": 1,
   "description": "Set to Completed by the driver's app when they tap 'Complete Route'. Resets to Active on the next day the route fires."
  },
  {
   "fieldname": "completed_at",
   "fieldtype": "Datetime",
   "label": "Completed At",
   "read_only": 1
  },
  {
   "fieldname": "frequency_section",
