{
 "actions": [],
 "autoname": "format:VRP-{user}-{plan_date}",
 "creation": "2026-04-19 00:00:00",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "route_name",
  "user",
  "plan_date",
  "status",
  "completed_at",
  "warehouse",
  "frequency_section",
  "frequency",
  "days_of_week",
  "interval_days",
  "valid_until",
  "notes",
  "stops",
  "completion_section",
  "completion_summary"
 ],
 "fields": [
  {
   "fieldname": "route_name",
   "fieldtype": "Data",
   "label": "Route Name",
   "in_list_view": 1,
   "description": "Friendly name shown to the driver (e.g. 'North Jeddah — Monday'). Optional today; will be required in a future release."
  },
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "Salesperson (User)",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "plan_date",
   "fieldtype": "Date",
   "label": "Plan Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nCompleted",
   "default": "Active",
   "in_list_view": 1,
   "read_only": 1,
   "description": "Set to Completed by the driver's app. Do not edit by hand — controls whether the driver can still act on stops."
  },
  {
   "fieldname": "completed_at",
   "fieldtype": "Datetime",
   "label": "Completed At",
   "read_only": 1
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Link",
   "label": "Van Warehouse",
   "options": "Warehouse"
  },
  {
   "fieldname": "frequency_section",
   "fieldtype": "Section Break",
   "label": "Recurrence"
  },
  {
   "fieldname": "frequency",
   "fieldtype": "Select",
   "label": "Frequency",
   "options": "One-time\nDaily\nWeekly\nBiweekly\nMonthly\nCustom",
   "default": "One-time",
   "in_list_view": 1,
   "description": "How often this route plan repeats. One-time = the single plan_date only."
  },
  {
   "fieldname": "days_of_week",
   "fieldtype": "Small Text",
   "label": "Days of Week",
   "depends_on": "eval:[\"Weekly\",\"Biweekly\",\"Custom\"].includes(doc.frequency)",
   "description": "Comma-separated short names: mon,tue,wed,thu,fri,sat,sun. Applies to Weekly/Biweekly/Custom."
  },
  {
   "fieldname": "interval_days",
   "fieldtype": "Int",
   "label": "Interval (days)",
   "depends_on": "eval:doc.frequency==\"Custom\"",
   "description": "For Custom frequency: number of days between repeats."
  },
  {
   "fieldname": "valid_until",
   "fieldtype": "Date",
   "label": "Valid Until",
   "description": "Optional end date for the recurrence window."
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "fieldname": "stops",
   "fieldtype": "Table",
   "label": "Stops",
   "options": "Van Route Stop"
  },
  {
   "fieldname": "completion_section",
   "fieldtype": "Section Break",
   "label": "Completion",
   "collapsible": 1,
   "depends_on": "eval:doc.status==\"Completed\""
  },
  {
   "fieldname": "completion_summary",
   "fieldtype": "Long Text",
   "label": "Completion Summary (JSON)",
   "read_only": 1,
   "description": "Daily-report snapshot captured at the moment Complete Route was tapped. Never mutate — used by the app to show a stable summary when the driver reopens a completed route."
  }
 ],
 "index_web_pages_for_search": 0,
 "links": [],
 "modified": "2026-04-20 00:00:00",
 "modified_by": "Administrator",
 "module": "Vansale",
 "name": "Van Route Plan",
 "owner": "Administrator",
 "permissions": [
  {
   "read": 1, "write": 1, "create": 1, "delete": 1, "role": "System Manager"
  },
  {
   "read": 1, "write": 1, "role": "Sales User"
  }
 ],
 "sort_field": "plan_date",
 "sort_order": "DESC",
 "track_changes": 1
}
