   "fieldtype": "Check",
   "label": "Thursday",
   "depends_on": "eval:doc.frequency===\"Weekly\""
  },
  {
   "fieldname": "fri",
   "fieldtype": "Check",
   "label": "Friday",
   "depends_on": "eval:doc.frequency===\"Weekly\""
  },
  {
   "fieldname": "sat",
   "fieldtype": "Check",
   "label": "Saturday",
   "depends_on": "eval:doc.frequency===\"Weekly\""
  },
  {
   "fieldname": "sun",
   "fieldtype": "Check",
   "label": "Sunday",
   "depends_on": "eval:doc.frequency===\"Weekly\""
  },
  {
   "fieldname": "days_of_month",
   "fieldtype": "Small Text",
   "label": "Days of Month",
   "depends_on": "eval:doc.frequency===\"Monthly\"",
