  {
   "fieldname": "completion_section",
   "fieldtype": "Section Break",
   "label": "Completion",
   "collapsible": 1,
   "depends_on": "eval:doc.status==\"Completed\""
  },
  {
   "fieldname": "completion_summary",
   "fieldtype": "Long Text",
   "label": "Completion Summary (JSON)",
   "read_only": 1,
   "description": "Daily-report snapshot captured at the moment Complete Route was tapped. Never mutate \u2014 used by the app to show a stable summary when the driver reopens a completed route."
  }
