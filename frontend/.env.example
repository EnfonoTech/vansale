# Per-customer build env. Copy to customers/.env.<id> or frontend/.env.local.

# Customer identifier — drives theming + app id.
CUSTOMER_NAME=demo
CUSTOMER_APP_ID=com.enfono.vansale.demo
CUSTOMER_APP_TITLE="Van Sale"
CUSTOMER_THEME_PRIMARY=#2563eb
CUSTOMER_THEME_BG=#f8fafc

# Build target — "web" (PWA) or "native" (Capacitor)
CUSTOMER_BUILD_TARGET=web

# Native API base (APK only — web uses relative paths via Frappe)
VITE_API_BASE=https://van-demo.enfonoerp.com

# Initial default language — "en" or "ar"
VITE_DEFAULT_LOCALE=en
