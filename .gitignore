htmlcov/
venv/
.venv/

# Node
node_modules/
.npm/
.pnpm-store/

# Build output (never commit)
frontend/dist/
vansale/public/spa/
android-capacitor/www/
android-capacitor/android/app/build/
android-capacitor/android/build/
android-capacitor/android/.gradle/

# Per-customer brand mark, staged from customers/assets/<customer>/ by
# `generate-customer-assets.mjs brand`. Generated per build — committing it
# would leak one client's logo into the next client's build.
frontend/public/brand-logo.png
android-capacitor/public/brand-logo.png

# Per-customer launcher icon + splash, regenerated from
# customers/assets/<customer>/ by `generate-customer-assets.mjs android`.
# Tracking them would mean the tree carries whichever customer built last —
# and since build-customer.sh refuses a dirty tree, a demo build right after
# a fateh build would be blocked by nothing but artwork churn.
android-capacitor/android/app/src/main/res/mipmap-*/ic_launcher*.png
android-capacitor/android/app/src/main/res/drawable*/splash.png
android-capacitor/android/app/src/main/res/drawable-night*/
android-capacitor/android/app/src/main/res/drawable-*-night-*/
android-capacitor/android/app/src/main/res/drawable-*-ldpi/
android-capacitor/android/app/src/main/res/mipmap-ldpi/
android-capacitor/android/app/src/main/res/values/colors.xml
android-capacitor/android/app/src/main/res/values/strings.xml
android-capacitor/android/app/src/main/res/values/ic_launcher_background.xml

# APK + release artifacts
*.apk
*.aab
dist/*.apk

# Keystore (NEVER commit)
*.keystore
*.jks
android-capacitor/keystore/
~/.vansale-keystore-pw

# Stale build artifacts (fatehhr lesson)
frontend/**/*.vue.js
frontend/**/*.vue.d.ts
frontend/src/**/*.js.map
frontend/tsconfig.tsbuildinfo
frontend/src/app/frappe.js

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Env files (per-customer secrets)
customers/.env.*
!customers/.env.example
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Study workspace (cloned reference repos, not part of this project)
van-sales-study/

# Generated docs site (rebuild with scripts/build-docs-site.py)
dist/docs-site/
